# ---------- REQUIRED ----------
# MongoDB Atlas connection string (Atlas > Connect > Drivers). Include the database name, e.g. .../meridian?retryWrites=true&w=majority
# Local MongoDB alternative: mongodb://127.0.0.1:27017/meridian
MONGO_URI=
# Any long random text (30+ characters). Never share it or commit it.
JWT_SECRET=
# Render sets PORT by itself. Only used on your own computer.
PORT=5000

# ---------- RECOMMENDED ON RENDER ----------
# Makes sign-ups employees only (no role dropdown). Leave as "production" when deployed.
NODE_ENV=production
# Your Vercel address, e.g. https://meridian-xxxx.vercel.app (several allowed, comma separated). Empty = allow any website.
CLIENT_URL=

# ---------- OPTIONAL ----------
# Set to true to create the 4 demo accounts (employee/manager/finance/admin@company.com, password demo123) on startup.
# DEMO MODE: turn it back to false after your presentation if the site stays online.
SEED_DEMO_USERS=false
# Set to false to turn off self sign-up (accounts then have to be created by an admin).
ALLOW_SIGNUP=true
# Only allow sign-up from one email domain, e.g. mycollege.edu. Empty = any email.
ALLOWED_EMAIL_DOMAIN=
# Local testing only: lets the sign-up form pick any role. Ignored when NODE_ENV=production.
SIGNUP_ROLE_CHOICE=false

# Receipts: saved on the server disk by default. Render's free disk is wiped on redeploy/restart,
# so for permanent receipts create a free Cloudinary account and fill these three.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email notifications (in-app notifications are used if SMTP_HOST is empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Meridian <no-reply@company.com>
