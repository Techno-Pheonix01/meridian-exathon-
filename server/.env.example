MONGO_URI=mongodb://127.0.0.1:27017/meridian
JWT_SECRET=change-me
PORT=5000
# Optional: Cloudinary receipts (local uploads/ used if blank)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: email notifications (in-app only if SMTP_HOST blank)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Meridian <no-reply@company.com>

# Google / LinkedIn sign-in (leave blank to hide failures; buttons then show "not configured")
APP_URL=http://localhost:5173        # public origin of the web app (the Vite dev server proxies /api to this server)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Anyone with a Google/LinkedIn account can sign up as an employee. Set false to require admin-created accounts.
OAUTH_AUTO_CREATE=true
# Optional: only allow this email domain (e.g. company.com). Leave blank to allow any.
OAUTH_ALLOWED_DOMAIN=

# Email + password self sign-up (employees only). Set false to allow only admin-created accounts.
ALLOW_SIGNUP=true

# TESTING MODE: the sign-up form can choose any role (employee/manager/finance/admin). ON by default while developing;
# automatically OFF when NODE_ENV=production. Set to false to turn it off yourself.
SIGNUP_ROLE_CHOICE=true
